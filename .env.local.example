# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, NEVER expose to the client/browser

# Google Cloud OAuth Client (Part A, step 4/5 of the setup steps)
# Same client used by Supabase's Google provider — needed here too, separately,
# because refreshing a Calendar token requires the client id/secret directly.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Google Drive service account (Part A, step 6) — base64-encode the whole downloaded
# JSON key file into a single line, e.g.:
#   base64 -i service-account-key.json | tr -d '\n'
GOOGLE_DRIVE_SERVICE_ACCOUNT_KEY=base64-encoded-json-key
